<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="WoW Ding" Manufacturer="WoW Ding" Version="$(var.Version)"
           UpgradeCode="499ED256-1992-4119-ABDF-8302F7AC8228" Scope="perUser" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of WoW Ding is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="APPDIR" Name="WoW Ding" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="StartupFolder"><Directory Id="AUTOSTARTDIR" Name="." /></StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"><Directory Id="MENUDIR" Name="WoW Ding" /></StandardDirectory>
    <Feature Id="Ding" Title="WoW Ding">
      <Component Id="App" Directory="APPDIR" Guid="21478EF4-B1D9-4A21-9F06-7AB5C5D70D0B">
        <File Id="DingExe" Source="$(var.Exe)" Name="WoWDing.exe" KeyPath="no" />
        <File Id="Notices" Source="$(var.Notices)" Name="Notices.txt" />
        <RegistryValue Root="HKCU" Key="Software\WoW Ding\Installer" Name="Installed" Value="1"
                       Type="integer" KeyPath="yes" />
        <Shortcut Id="OpenDing" Directory="MENUDIR" Name="WoW Ding" Target="[#DingExe]"
                  Description="Set up Discord level-up notifications for WoW Forever" WorkingDirectory="APPDIR" />
        <Shortcut Id="StartDing" Directory="AUTOSTARTDIR" Name="WoW Ding" Target="[#DingExe]"
                  Arguments="--watch" WorkingDirectory="APPDIR" />
        <RemoveFolder Id="RemoveMenu" Directory="MENUDIR" On="uninstall" />
        <RemoveFolder Id="RemoveApp" Directory="APPDIR" On="uninstall" />
      </Component>
    </Feature>
    <CustomAction Id="OpenSetup" FileRef="DingExe" ExeCommand="--setup" Execute="immediate" Return="asyncNoWait" />
    <CustomAction Id="RemoveSettings" FileRef="DingExe" ExeCommand="--remove" Execute="deferred" Impersonate="yes" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="OpenSetup" After="InstallFinalize" Condition="NOT Installed AND UILevel &gt;= 4 AND NOT REMOVE" />
      <Custom Action="RemoveSettings" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
